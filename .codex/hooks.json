{
  "description": "Global hooks for Codex workspace integration.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/zsh ~/.agents/hooks/jj-snapshot-after-edit.zsh",
            "timeout": 30,
            "statusMessage": "Snapshotting jj working copy"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent codex 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
