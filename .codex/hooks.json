{
  "description": "Global hooks for Codex workspace integration.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/zsh ~/.codex/hooks/jj-snapshot-after-edit.zsh",
            "timeout": 30,
            "statusMessage": "Snapshotting jj working copy"
          }
        ]
      }
    ]
  }
}
