prefix_rule(
    pattern = ["jj", "git", "push"],
    decision = "prompt",
    justification = "Pushing mutates a remote repository.",
    match = [
        "jj git push",
        "jj git push --bookmark feature",
        "jj git push -c @-",
    ],
)

prefix_rule(
    pattern = ["jj", "op", "abandon"],
    decision = "prompt",
    justification = "Abandoning operations can remove recovery history.",
    match = ["jj op abandon abc123"],
)

prefix_rule(
    pattern = ["jj", "workspace", ["add", "forget", "rename"]],
    decision = "prompt",
    justification = "This changes persistent workspace registration.",
    match = [
        "jj workspace add ../feature",
        "jj workspace forget feature",
        "jj workspace rename feature",
    ],
)
